[gd_resource type="Resource" script_class="GuardianLines" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/guardian_lines.gd" id="1_lines"]

[resource]
script = ExtResource("1_lines")
chapter = 1
conversations = Array[PackedStringArray]([PackedStringArray("Девять раз упал — и снова стоишь у моего столба.", "Здесь хоронят тех, кого не берёт ни земля, ни вода. Тебя пока не берёт ни то, ни другое.", "Загадка, котёнок: что легче взять, чем вернуть, и тяжелее носить, чем отдать?", "Подумай об этом у своего трактирщика. Ступай — дорога сама найдёт тебе ноги."), PackedStringArray("Опять ты. Дорог здесь четыре, а ведут все в одно место.", "Фонари на твоём пути — не для света. Они помнят, где ты был живым.", "Зажигай их, пока есть что помнить. Иди."), PackedStringArray("Знаешь, почему козлов ставят на перекрёстках? Мы читаем то, что подписывают другие.", "Бумага, которую не дочитали, всегда дочитывает себя сама. Обычно — в самый неудобный час.", "Просыпайся, котёнок. Тебя ждут пироги.")])
