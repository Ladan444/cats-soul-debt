company = "Караул северных ворот"
memory = "Молодой хорёк с вечно холодным носом. Знал все лазы крепости и проходил «как сквозь стены». Каждую ночь Рэй шёл мимо его поста к печати — и Финн ни разу не записал этого в журнал караула. В Ночь Рубежа он прятал раненых в водостоках."
skill = ExtResource("2_skill")
