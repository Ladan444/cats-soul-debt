[resource]
script = ExtResource("1_soul")
id = &"soul_jorg"
name = "Йорг"
company = "Третья рота"
memory = "Мечник третьей роты, муж Ильзы-швеи, отец котёнка, что играет у колодца. «Бил дважды там, где другие раз». В Ночь Рубежа держал дверь трапезной, пока уходили раненые, — и не ушёл сам. В кармане — недописанное письмо домой."
skill = ExtResource("2_skill")
